{
  "name": "brickmoji",
  "version": "0.1.0",
  "description": "BRICKMOJI — a tiny brick-breaker with bitmoji-style faces, built as a Snapchat Web Lens",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "serve": "node scripts/serve.mjs dist",
    "start": "npm run build && npm run serve",
    "lens": "node scripts/lens.mjs",
    "test": "vitest --run"
  },
  "devDependencies": {
    "@snap/web-lens-api": "^0.1.2",
    "esbuild": "0.24.0",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
